# =============================================================================
# dar-lakehouse-pilot — environment template
# Copy to .env and run: make generate-secrets  (fills CHANGE_ME values)
# NEVER commit .env with real credentials.
# =============================================================================

# ── Project ──────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=dar-lakehouse

# ── SeaweedFS (S3-compatible object storage) ─────────────────────────────────
SEAWEEDFS_VERSION=3.75
SEAWEEDFS_MASTER_PORT=9333
SEAWEEDFS_VOLUME_PORT=8080
SEAWEEDFS_FILER_PORT=8888
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_REPLICATION=000               # single-node: no replication
SEAWEEDFS_MAX_VOLUMES=100
# S3 credentials for the gateway
S3_ENDPOINT=http://seaweedfs-s3:8333
S3_ACCESS_KEY=CHANGE_ME_AKID
S3_SECRET_KEY=CHANGE_ME_SAK
S3_REGION=us-east-1                     # SeaweedFS ignores region but SDK requires it
S3_PATH_STYLE=true                      # REQUIRED — Trino and Lakekeeper need path-style

# ── Bucket names (no proprietary branding in names) ───────────────────────────
BUCKET_BRONZE=bronze-lakehouse
BUCKET_SILVER=silver-lakehouse
BUCKET_GOLD=gold-lakehouse
BUCKET_RAW_FILES=raw-files
BUCKET_AUDIT=audit-logs

# ── PostgreSQL — shared metadata DB (Lakekeeper, OpenMetadata) ───────────────
PG_META_HOST=postgres-meta
PG_META_PORT=5432
PG_META_DB=lakehouse_meta
PG_META_USER=lakehouse
PG_META_PASSWORD=CHANGE_ME_PG_META

# Lakekeeper catalog DB (database within postgres-meta)
LAKEKEEPER_DB=lakekeeper
LAKEKEEPER_DB_USER=lakekeeper
LAKEKEEPER_DB_PASSWORD=CHANGE_ME_LK

# OpenMetadata DB (database within postgres-meta)
OM_DB=openmetadata_db
OM_DB_USER=openmetadata
OM_DB_PASSWORD=CHANGE_ME_OM

# ── PostgreSQL — Airflow metadata DB ─────────────────────────────────────────
PG_AIRFLOW_HOST=postgres-airflow
PG_AIRFLOW_PORT=5433
PG_AIRFLOW_DB=airflow
PG_AIRFLOW_USER=airflow
PG_AIRFLOW_PASSWORD=CHANGE_ME_AF
AIRFLOW_FERNET_KEY=CHANGE_ME_FERNET_32B
AIRFLOW_WEBSERVER_SECRET=CHANGE_ME_WS_SECRET

# ── PostgreSQL — DAR_DW (source data warehouse) ───────────────────────────────
PG_DW_HOST=postgres-dw
PG_DW_PORT=5434
PG_DW_DB=DAR_DW
PG_DW_USER=dar_dw_reader
PG_DW_PASSWORD=CHANGE_ME_DW
PG_DW_SA_USER=dar_dw_admin
PG_DW_SA_PASSWORD=CHANGE_ME_DW_ADMIN

# ── Lakekeeper (Iceberg REST Catalog) ─────────────────────────────────────────
LAKEKEEPER_VERSION=v0.13.6
LAKEKEEPER_PORT=8181
LAKEKEEPER_CATALOG_URI=http://lakekeeper:8181
# OAuth2 client for Lakekeeper (Keycloak client)
LAKEKEEPER_OIDC_CLIENT_ID=lakekeeper
LAKEKEEPER_OIDC_CLIENT_SECRET=CHANGE_ME_LK_OIDC

# ── Trino ─────────────────────────────────────────────────────────────────────
TRINO_VERSION=455
TRINO_PORT=18080
TRINO_JVM_HEAP_MAX=4G                   # 64 GB host → comfortable
TRINO_CATALOG_ICEBERG=iceberg
TRINO_DEFAULT_CATALOG=iceberg
TRINO_DEFAULT_SCHEMA=bronze

# ── OPA ───────────────────────────────────────────────────────────────────────
OPA_VERSION=0.68.0
OPA_PORT=8282

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_VERSION=26.0.7
KEYCLOAK_PORT=8443
KEYCLOAK_HTTP_PORT=8444
KEYCLOAK_REALM=dar-lakehouse
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KC_ADMIN

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW_VERSION=2.10.2
AIRFLOW_PORT=8079
AIRFLOW_EXECUTOR=LocalExecutor        # NO Redis/Celery required
AIRFLOW_LOAD_EXAMPLES=false
# OpenLineage transport
OPENLINEAGE_URL=http://openmetadata:8585/api/v1/lineage/openlineage

# ── OpenSearch (shared: OpenMetadata om_* + UC1 uc1_*) ───────────────────────
OPENSEARCH_VERSION=3.3.2
OPENSEARCH_PORT=9200
OPENSEARCH_TRANSPORT_PORT=9300
OPENSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"
OPENSEARCH_INITIAL_ADMIN_PASSWORD=DarLakehouseAdmin123!   # required 2.12+

# ── OpenSearch Dashboards ─────────────────────────────────────────────────────
OPENSEARCH_DASHBOARDS_VERSION=3.3.0
OPENSEARCH_DASHBOARDS_PORT=5601

# ── OpenMetadata ──────────────────────────────────────────────────────────────
OPENMETADATA_VERSION=2.0.3
OPENMETADATA_PORT=8585
OPENMETADATA_PIPELINE_SERVICE_CLIENT_ENDPOINT=http://openmetadata-ingestion:8080

# ── Apache Tika ───────────────────────────────────────────────────────────────
TIKA_VERSION=2.9.2.1-full
TIKA_PORT=9998

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_VERSION=0.3.14
OLLAMA_PORT=11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M     # Apache-2.0
OLLAMA_EMBED_MODEL=nomic-embed-text:1.5          # Apache-2.0
OLLAMA_GPU=false                                  # set true to enable CUDA (opt-gpu)

# ── Apache Superset ───────────────────────────────────────────────────────────
SUPERSET_VERSION=4.1.1
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=CHANGE_ME_SS_SECRET
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=CHANGE_ME_SS_ADMIN

# ── Kong OSS (API gateway, DB-less) ──────────────────────────────────────────
KONG_VERSION=3.8.0
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001

# ── FastAPI services ──────────────────────────────────────────────────────────
DATA_API_PORT=8092
SEARCH_API_PORT=8093
D365_MOCK_PORT=8090
SHAREPOINT_MOCK_PORT=8091

# ── Samba (file share) — host port 1445 (not 445, reserved on Windows) ────────
SAMBA_HOST_PORT=1445

# ── Gitea + act_runner ────────────────────────────────────────────────────────
GITEA_VERSION=1.22.3
GITEA_HTTP_PORT=3001
GITEA_SSH_PORT=222
GITEA_RUNNER_VERSION=0.2.11
GITEA_ADMIN_USER=gitea-admin
GITEA_ADMIN_PASSWORD=CHANGE_ME_GITEA

# ── OpenTofu ──────────────────────────────────────────────────────────────────
TOFU_VERSION=1.8.3

# ── Prometheus + Grafana ──────────────────────────────────────────────────────
PROMETHEUS_VERSION=v2.54.1
PROMETHEUS_PORT=9090
GRAFANA_VERSION=11.2.2
GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GF_ADMIN

# ── Fluent Bit ────────────────────────────────────────────────────────────────
FLUENT_BIT_VERSION=3.1.9

# ── cAdvisor ─────────────────────────────────────────────────────────────────
CADVISOR_VERSION=v0.50.0
CADVISOR_PORT=8094

# ── Mailpit ───────────────────────────────────────────────────────────────────
MAILPIT_VERSION=v1.21.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ── Trivy ─────────────────────────────────────────────────────────────────────
TRIVY_VERSION=0.55.2

# ── OWASP ZAP ─────────────────────────────────────────────────────────────────
ZAP_VERSION=2.15.0

# ── Locust ───────────────────────────────────────────────────────────────────
LOCUST_VERSION=2.31.6
LOCUST_PORT=8089

# ── Source DW selector (postgres | sqlserver) ─────────────────────────────────
SOURCE_DW=postgres

# ── Environment (dev | uat | prod) ───────────────────────────────────────────
ENVIRONMENT=dev
ICEBERG_NAMESPACE_PREFIX=${ENVIRONMENT}
