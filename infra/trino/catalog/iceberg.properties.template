# Iceberg catalog — TEMPLATE (generated by scripts/generate-configs.sh)
# DO NOT edit the generated file infra/trino/catalog/iceberg.properties directly.
# Edit this template and re-run `scripts/generate-configs.sh`.

connector.name=iceberg
iceberg.catalog.type=rest
iceberg.rest-catalog.uri=http://lakekeeper:8181/catalog/default/dar-lakehouse-${ENVIRONMENT}

# S3 file I/O — path-style required by SeaweedFS
fs.native-s3.enabled=true
s3.endpoint=http://seaweedfs-s3:8333
s3.region=${S3_REGION}
s3.path-style-access=true
s3.aws-access-key=${S3_ACCESS_KEY}
s3.aws-secret-key=${S3_SECRET_KEY}

# Iceberg options
iceberg.file-format=PARQUET
iceberg.target-max-file-size=256MB
iceberg.compression-codec=SNAPPY
iceberg.format-version=2
