{
  "identities": [
    {
      "name": "lakehouse-service",
      "credentials": [
        {
          "accessKey": "${S3_ACCESS_KEY}",
          "secretKey": "${S3_SECRET_KEY}"
        }
      ],
      "actions": [
        "Read", "Write", "List", "Tagging", "Admin"
      ]
    },
    {
      "name": "readonly-service",
      "credentials": [
        {
          "accessKey": "readonly-${S3_ACCESS_KEY}",
          "secretKey": "readonly-${S3_SECRET_KEY}"
        }
      ],
      "actions": [
        "Read", "List"
      ]
    }
  ]
}
